; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in [] on its own line
;   param=value ; parameter goes in the same line
;
; Only save relevant lines. Do not remove [gd_scene] if it's relevant.

config_version=5

[application]

config/name="Angry Brainrot"
config/description="The most absurd slingshot game ever made"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/sprites/icon.png"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

2d/default_gravity=980.0

[rendering]

textures/canvas_textures/default_texture_filter=0
